{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["**/*.json"],
      "options": {
        "printWidth": 140,
        "trailingComma": "none"
      }
    },
    {
      "files": ["**/*.md"],
      "options": {
        "printWidth": 90,
        "proseWrap": "preserve"
      }
    }
  ]
}
