# Secrets — never commit. .env.sample is the committed template.
.env
.env.local
.env.*.local

# Go
/backend/bin/
*.test
*.out
coverage.html
coverage.txt

# Node
node_modules/
/frontend/dist/
/frontend/.vite/
npm-debug.log*

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code — machine-local overrides only; settings.json IS committed
.claude/settings.local.json

# Python tooling venv (scripts/requirements.txt)
.venv/

# Go tool binaries installed by `make setup`
.tools/

# dev.sh's working directory: built binaries, a signing keypair and logs. The
# key is a real private key — throwaway, but never committed.
backend/.dev/
.up-*.log

# Stitch bearer token — a real credential, never committed.
.stitch-token

# Screenshots dropped in to report a UI problem. Scratch input for a fix, not
# an artefact of the project — and they accumulate fast.
frontend/problems/
