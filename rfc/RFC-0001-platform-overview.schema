-- RFC-0001 — Platform overview, domain model & service topology
-- Schema delta: foundational conventions only. No domain tables.
--
-- PostgreSQL dialect. This file is a DELTA; the full schema is the ordered
-- concatenation of every approved RFC's .schema file.

-- ---------------------------------------------------------------------------
-- Extensions
-- ---------------------------------------------------------------------------

-- citext: case-insensitive comparison for values that are case-insensitive in
-- the real world (email, GitHub login, repository owner/name).
CREATE EXTENSION IF NOT EXISTS citext;

-- pg_trgm: trigram indexes backing the recruiter free-text search in RFC-0005.
CREATE EXTENSION IF NOT EXISTS pg_trgm;

-- ---------------------------------------------------------------------------
-- Conventions — binding on every table introduced by a later RFC
-- ---------------------------------------------------------------------------
--
-- 1. PRIMARY KEY is `id uuid`, generated by the application as UUIDv7.
--    Rationale: v7 is time-ordered, so inserts stay at the right edge of the
--    B-tree (unlike v4), while remaining opaque and non-enumerable (unlike a
--    bigserial). Generated app-side so the repository layer never depends on a
--    database function — a requirement for swapping the storage engine.
--
-- 2. Timestamps are `timestamptz`, never `timestamp`. Stored in UTC.
--    Every table carries `created_at` and `updated_at`.
--
-- 3. Deletion is soft where an audit trail matters (`deleted_at timestamptz`)
--    and hard where it does not. Each table states which it uses and why.
--
-- 4. Money and scores are `numeric`, never floating point. Scores are
--    `numeric(5,2)` on a 0.00-100.00 scale.
--
-- 5. Enumerated values are PostgreSQL enum types, not check constraints or
--    free-text columns. Adding a value is a migration, which is the point:
--    a new claim status should be a reviewed change.
--
-- 6. Names are snake_case; tables are plural; join tables are
--    `<left>_<right>`; foreign keys are `<singular_referenced_table>_id`.
--
-- 7. Every foreign key declares its ON DELETE behaviour explicitly. There is
--    no default in this codebase.
--
-- 8. The repository layer maps these rows to domain models. No domain model
--    is permitted to expose a PostgreSQL-specific type.

-- ---------------------------------------------------------------------------
-- Shared trigger: maintain updated_at
-- ---------------------------------------------------------------------------

CREATE OR REPLACE FUNCTION set_updated_at() RETURNS trigger AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION set_updated_at() IS
    'BEFORE UPDATE trigger. Every table with an updated_at column attaches this '
    'as trg_<table>_updated_at, so the application never sets the column itself.';

-- Attachment pattern used by every later table:
--
--   CREATE TRIGGER trg_<table>_updated_at
--       BEFORE UPDATE ON <table>
--       FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- ---------------------------------------------------------------------------
-- schema_migrations — idempotent application at api boot
--
-- There is no migrate binary (RFC-0001). The api applies pending migrations in
-- order on startup and skips those already recorded here, so booting against a
-- current database is a no-op and booting twice is safe.
--
-- The advisory lock is what makes that true with more than one replica: every
-- instance starts, exactly one holds the lock and applies, the rest wait and
-- then find nothing to do.
-- ---------------------------------------------------------------------------

CREATE TABLE IF NOT EXISTS schema_migrations (
    version     text PRIMARY KEY,          -- '0002_identity', ordered lexically
    checksum    bytea       NOT NULL,      -- detects an edited, already-applied file
    applied_at  timestamptz NOT NULL DEFAULT now(),
    duration_ms integer
);

-- Boot sequence:
--   SELECT pg_advisory_lock(<constant>);
--   -- apply every migration not present in schema_migrations, in order,
--   -- each in its own transaction, recording version + checksum
--   SELECT pg_advisory_unlock(<constant>);
--
-- A checksum mismatch on an already-applied version is a startup failure, not
-- a warning: it means a migration was edited after being applied somewhere,
-- and the two databases have silently diverged.
