      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles",
        "body": {
          "title": "Platform engineer",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote"
            }
          ],
          "currency": "GBP",
          "yearly_ctc": 0
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "invalid_role",
          "field": "yearly_ctc"
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles",
        "body": {
          "title": "Platform engineer",
          "engagement": "full_time",
