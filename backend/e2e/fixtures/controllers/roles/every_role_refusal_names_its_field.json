      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles",
        "body": {
          "title": "Platform engineer",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote"
            }
          ],
          "currency": "pounds",
          "yearly_ctc": 9000000
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "invalid_role",
          "field": "currency"
        }
      }
    },
    {
      "_step": "An amount that is not positive names WHICH amount.",
