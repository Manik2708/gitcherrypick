          "supersedes": null,
          "created_at": "<timestamp>",
          "updated_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "A second revision of the same role conflicts. Two successors would leave two rows each claiming to be current, and nothing able to say which a contributor should be shown.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{role}}/revise",
        "body": {
          "title": "Third go",
