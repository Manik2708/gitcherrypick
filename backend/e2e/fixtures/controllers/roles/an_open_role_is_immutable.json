          "requires_online_test": null,
          "max_interview_rounds": null,
          "avg_days_to_offer": null,
          "questions": [],
          "opened_at": "<timestamp>",
          "close_requested_at": null,
          "closed_at": "<timestamp>",
          "close_reason": "hired_elsewhere",
          "hires": [],
          "advertised": false,
          "supersedes": "<uuid>",
          "created_at": "<timestamp>",
          "updated_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "A CLOSED ROLE IS FINAL. Refused at the API rather than merely left out of the client, because a hirer is WARNED about this before they close anything — and a rule somebody is warned about has to be true afterwards. Everybody contacted was told the role closed, and a job that un-closes makes that a lie.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{revision}}/open"
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "role_is_open"
        }
      }
