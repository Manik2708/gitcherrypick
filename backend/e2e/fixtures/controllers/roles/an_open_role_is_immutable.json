    },
    {
      "_step": "'superseded' is written by a revision and offered to nobody.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{revision}}/close",
        "body": {
          "reason": "superseded"
