    {
      "_step": "THE CONTRIBUTOR'S READ. Remote in Britain; onsite in Bengaluru, India and in Austin, US. No `address` key, no street, no postcode, no id — the response cannot leak what it does not carry.",
      "as": "alice",
      "request": {
        "method": "GET",
        "path": "/me/contact-requests"
      },
      "expect": {
        "status": 200,
        "_note": "Exactly three keys on an onsite entry and two on a remote one. An extra key here is the leak this case exists to catch.",
        "body": {
          "total": 1,
          "requests": [
            {
              "id": "<uuid>",
              "organization": {
                "name": "Acme Corp",
                "verified": true,
                "payment_verified": true
              },
              "status": "pending",
              "tentative_result_date": "2026-09-30",
              "disclosure": null,
              "role": {
                "id": "<uuid>",
                "title": "Field engineer",
                "description": "",
                "engagement": "full_time",
                "locations": [
                  {
                    "mode": "remote",
                    "country": "GB"
                  },
                  {
                    "mode": "onsite",
                    "country": "IN",
                    "city": "Bengaluru"
                  },
                  {
                    "mode": "onsite",
