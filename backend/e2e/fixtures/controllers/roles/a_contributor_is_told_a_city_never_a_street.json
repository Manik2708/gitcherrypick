                    "city": "Austin"
                  }
                ],
                "currency": "",
                "yearly_ctc": null,
                "yearly_base": null,
                "hourly_rate": null,
                "expected_hours": null,
                "requires_online_test": null,
                "max_interview_rounds": null,
                "avg_days_to_offer": null,
                "questions": []
              },
              "expires_at": "<timestamp>",
              "created_at": "<timestamp>"
            }
          ]
        }
      }
    },
    {
      "_step": "THE EMAIL names both cities and neither address. One message, and it must satisfy both lists.",
      "as": "system",
      "request": {
        "method": "READ_EMAIL",
        "path": "/",
        "body": {
          "to": "alice@example.com",
          "subject": "An organization is interested in your work",
          "contains": ["Bengaluru", "Austin"],
          "excludes": ["1 MG Road", "560001", "Floor 4", "500 W 2nd St", "78701", "Suite 300"],
          "count": 1
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "to": "alice@example.com",
          "subject": "An organization is interested in your work",
          "html": "<string>",
          "token": "<string>"
        }
      }
    }
