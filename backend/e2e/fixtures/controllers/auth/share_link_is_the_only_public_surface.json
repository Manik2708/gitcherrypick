{
  "name": "share links are the only thing an anonymous visitor can see",
  "description": "ADR-0002: scorecards are fully gated. A logged-out visitor sees nothing, a contributor sees only their OWN rank, and the single publishable surface is a link the contributor generates and can revoke. The link exposes that contributor alone — no ranking against anyone else, no navigation outward.",
  "seed": [
    "principals",
    "catalogue"
  ],
  "steps": [
    {
      "as": "anonymous",
      "request": {
        "method": "GET",
        "path": "/contributors/{{alice.id}}/scorecard"
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "authentication_required"
        }
      }
    },
    {
      "_step": "A contributor cannot browse to someone else's card either.",
      "as": "bob",
      "request": {
        "method": "GET",
        "path": "/contributors/{{alice.id}}/scorecard"
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "forbidden",
          "message": "Scorecards are visible to verified hiring accounts only."
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/me/share-link"
      },
      "capture": {
        "share_token": "$.token",
        "share_link_id": "$.id"
      },
      "expect": {
        "status": 201,
        "_note": "Shown once. Stored hashed, so a database disclosure yields no working links.",
        "body": {
          "id": "<uuid>",
          "token": "<token>",
          "url": "<token>",
          "created_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "Anonymous, with the token — permitted, and scoped to Alice alone.",
      "as": "anonymous",
      "request": {
        "method": "GET",
        "path": "/public/scorecard/{{share_token}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "_note": "No id and no rank. A published link carries the contributor's presentation, not a handle to query them by, and rank is a fact about the pool (ADR-0002).",
          "user": {
            "display_name": "Alice Okafor",
            "github_login": "aliceok"
          },
          "skills": [],
          "overall_score": null,
          "generalist_score": null,
          "rubric_version": "v1"
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "DELETE",
        "path": "/me/share-link/{{share_link_id}}"
      },
      "expect": {
        "status": 204,
        "body": null
      }
    },
    {
      "as": "anonymous",
      "request": {
        "method": "GET",
        "path": "/public/scorecard/{{share_token}}"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "not_found"
        }
      }
    },
    {
      "_step": "A contributor may see their own rank — and only their own.",
      "as": "alice",
      "request": {
        "method": "GET",
        "path": "/me/rank"
      },
      "expect": {
        "status": 200,
        "body": {
          "_note": "Rank is a fact about the pool, so a contributor sees their own position and nothing identifying anyone else. With no scored evidence there is no position — null, not zero, because zero would claim a measurement (ADR-0007).",
          "rubric_version": "v1",
          "ranked": false,
          "unranked_reason": "no_primary_skill",
          "active": true,
          "overall": {
            "score": null,
            "rank": null,
            "out_of": 4
          },
          "generalist": {
            "score": null,
            "rank": null,
            "out_of": 4
          },
          "skills": []
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "GET",
        "path": "/leaderboard?kind=skill&skill=go"
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "hirer_required"
        }
      }
    }
  ]
}
