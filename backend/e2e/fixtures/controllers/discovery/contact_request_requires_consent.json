{
  "name": "shortlisting raises a request; the email is released only on acceptance",
  "description": "ADR-0005, and the deliberate inversion of how sourcing tools normally work. Adding someone to a shortlist does NOT disclose their email — it creates a contact request the contributor must accept. Releasing contact details on the strength of one side's interest is what makes those tools feel extractive, and the whole consent model would be hollow if a shortlist click bypassed it.\n\nThe request also discloses what we know about the hirer: sam_studio's organization was verified on identity but never on payment, so the contributor is told before deciding.\n\nUpdated for RFC-0008 §3a: adding an entry stages it privately and discloses nothing. The contact request — and therefore the disclosure this case is about — is created by confirm. That moves WHEN consent is sought without changing the rule that it must be sought.",
  "seed": ["principals", "catalogue", "repositories", "scored_population"],
  "steps": [
    {
      "as": "sam_studio",
      "request": {
        "method": "POST",
        "path": "/shortlists",
        "body": {
          "role_id": "{{startup.role}}",
          "name": "Backend contractor, Q3",
          "tentative_result_date": "2026-09-30"
        }
      },
      "capture": {
        "shortlist": "$.id"
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "role_id": "<uuid>",
          "name": "Backend contractor, Q3",
          "status": "draft",
          "tentative_result_date": "2026-09-30",
          "created_at": "<timestamp>"
        }
      }
    },
    {
      "as": "sam_studio",
      "request": {
        "method": "POST",
        "path": "/shortlists/{{shortlist}}/entries",
        "body": {
          "user_id": "{{alice.id}}",
          "note": "Strong retry-semantics work."
        }
      },
      "expect": {
        "status": 201,
        "_note": "No email in the response. A contact request was raised instead.",
        "body": {
          "_note": "Staged, not disclosed. notified_at is null until confirm, and no address appears anywhere — releasing one is what accepting a contact request does (ADR-0008 §3a).",
          "shortlist_id": "<uuid>",
          "user": {
            "id": "01920000-0000-7000-8000-00000000a001",
            "display_name": "Alice Okafor",
            "github_login": "<string>"
          },
          "note": "Strong retry-semantics work.",
          "added_by": {
            "id": "01920000-0000-7000-8000-00000000c003",
            "username": "sam",
            "display_name": "Sam Ortega",
            "active": true
          },
          "notified_at": null,
          "added_at": "<timestamp>"
        },
        "db": {
          "contact_requests": {
            "_note": "Zero. Staging is private — RFC-0008 §3a.",
            "where": {
              "user_id": "01920000-0000-7000-8000-00000000a001"
            },
            "count": 0
          }
        }
      }
    },
    {
      "_step": "Confirm is what discloses. Tiny Studio is verified on identity but NOT on payment, so the label is shown.",
      "as": "sam_studio",
      "request": {
        "method": "POST",
        "path": "/shortlists/{{shortlist}}/confirm",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "open",
          "notified": 1,
          "already_notified": 0,
          "irreversible": true,
          "first_confirmed_at": "<timestamp>",
          "entries": [
            {
              "user_id": "01920000-0000-7000-8000-00000000a001",
              "display_name": "Alice Okafor",
              "contact_request_id": "<uuid>",
              "notified_at": "<timestamp>"
            }
          ]
        },
        "db": {
          "contact_requests": {
            "where": {
              "user_id": "01920000-0000-7000-8000-00000000a001"
            },
            "count": 1,
            "all_match": {
              "status": "pending"
            }
          }
        }
      }
    },
