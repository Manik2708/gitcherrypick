{
  "name": "a saved search stores the filter set verbatim and replays it",
  "description": "RFC-0008 §5. The saved_searches table is in the approved schema with no endpoint that reaches it. Its filters column already carries a worked example, and those keys ARE the /search query parameters — so a saved search replays as a query string with no translation layer, and cannot drift from what search accepts.\n\nThe validation property matters more than the storage: an unknown filter key is a 422, not a key that is stored and then silently ignored at replay. A saved search that quietly drops 'min_generalist_score' because someone typed 'min_generalist' would return a different population than the recruiter believes they saved.\n\nOrg-scoped like shortlists, for the same reason.",
  "seed": ["principals", "catalogue", "repositories", "scored_population"],
  "steps": [
    {
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Go + Kubernetes",
          "filters": {
            "skills": ["go", "kubernetes"],
            "min_skill_score": 50
          }
        }
      },
      "capture": {
        "saved": "$.id"
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "name": "Go + Kubernetes",
          "filters": {
            "skills": ["go", "kubernetes"],
            "min_skill_score": 50
          },
          "organization": {
            "id": "01920000-0000-7000-8000-00000000b001",
            "name": "Acme Corp"
          },
          "created_by": {
            "id": "01920000-0000-7000-8000-00000000c001",
            "username": "hank",
            "display_name": "Hank Rivera",
            "active": true
          },
          "created_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "An unknown key is refused rather than stored and ignored.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Typo",
          "filters": {
            "skills": ["go"],
            "min_generalist": 100
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "unknown_filter",
          "items": [
            {
              "field": "min_generalist",
              "reason": "unknown_filter",
              "did_you_mean": "min_generalist_score"
            }
          ]
        },
        "db": {
          "saved_searches": {
            "where": {
              "name": "Typo"
            },
            "count": 0
          }
        }
      }
    },
    {
      "_step": "A known key with an unusable value is refused too. A skill outside the catalogue can never match.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Ghost skill",
          "filters": {
            "skills": ["cobol"]
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "unknown_skill",
          "items": [
            {
              "field": "skills",
              "value": "cobol",
              "reason": "not_in_catalogue"
            }
          ]
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Impossible",
          "filters": {
            "skills": ["go"],
            "min_skill_score": 140
          }
        }
      },
      "expect": {
        "status": 422,
        "_note": "Skill scores are ceiled at 100 (ADR-0007). 140 is not a narrow filter, it is an empty one.",
        "body": {
          "error": "invalid_filter",
          "items": [
            {
              "field": "min_skill_score",
              "reason": "out_of_range",
              "max": 100
            }
          ]
        }
      }
    },
    {
      "_step": "min_generalist_score has NO upper bound — the generalist score is deliberately unbounded, ADR-0007 §5.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Broad generalists",
          "filters": {
            "min_generalist_score": 120
          }
        }
      },
      "capture": {
        "generalist_saved": "$.id"
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "name": "Broad generalists",
          "filters": {
            "min_generalist_score": 120
          },
          "organization": {
            "id": "01920000-0000-7000-8000-00000000b001",
            "name": "Acme Corp"
          },
          "created_by": {
            "id": "01920000-0000-7000-8000-00000000c001",
            "username": "hank",
            "display_name": "Hank Rivera",
            "active": true
          },
          "created_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "A gate is not a filter. There is no parameter that shows lapsed profiles, secondary skills, or yourself — RFC-0008 §1.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Everyone",
          "filters": {
            "standing": "secondary"
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "unknown_filter",
          "items": [
            {
              "field": "standing",
              "reason": "unknown_filter"
            }
          ]
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Lapsed too",
          "filters": {
            "include_expired_availability": true
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "unknown_filter",
          "items": [
            {
              "field": "include_expired_availability",
              "reason": "unknown_filter"
            }
          ]
        }
      }
    },
    {
      "_step": "REPLAY. The stored filters produce the same result as the equivalent query string.",
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/saved-searches/{{saved}}/results"
      },
      "expect": {
        "status": 200,
        "_note": "Bob alone holds both Go and Kubernetes as primary, and both clear 50.",
        "body": {
          "total": 1,
          "inactive_hidden": 0,
          "ranked_by": "overall",
          "page": 1,
          "per_page": 20,
          "results": [
            {
              "id": "<uuid>",
              "display_name": "Bob Nakamura",
              "github_login": "bobn",
              "active": true,
              "availability": {
                "status": "looking",
                "expires_at": "<timestamp>"
              },
              "skills": [
                {
                  "slug": "go",
                  "standing": "primary",
                  "score": 55.0,
                  "rank": 2
                },
                {
                  "slug": "kubernetes",
                  "standing": "primary",
                  "score": 52.0,
                  "rank": 2
                }
              ],
              "overall_score": 60.4,
              "generalist_score": 122.7,
              "rank": 3
            }
          ]
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/search?skills=go,kubernetes&min_skill_score=50"
      },
      "expect": {
        "status": 200,
        "_note": "Byte-identical to the replay above. That equality is the reason the filter keys are the parameter names.",
        "body": {
          "total": 1,
          "inactive_hidden": 0,
          "ranked_by": "overall",
          "page": 1,
          "per_page": 20,
          "results": [
            {
              "id": "<uuid>",
              "display_name": "Bob Nakamura",
              "github_login": "bobn",
              "active": true,
              "availability": {
                "status": "looking",
                "expires_at": "<timestamp>"
              },
              "skills": [
                {
                  "slug": "go",
                  "standing": "primary",
                  "score": 55.0,
                  "rank": 2
                },
                {
                  "slug": "kubernetes",
                  "standing": "primary",
                  "score": 52.0,
                  "rank": 2
                }
              ],
              "overall_score": 60.4,
              "generalist_score": 122.7,
              "rank": 3
            }
          ]
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/saved-searches/{{generalist_saved}}/results"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 1,
          "inactive_hidden": 0,
          "ranked_by": "generalist",
          "page": 1,
          "per_page": 20,
          "results": [
            {
              "id": "<uuid>",
              "display_name": "Bob Nakamura",
              "github_login": "bobn",
              "active": true,
              "availability": {
                "status": "looking",
                "expires_at": "<timestamp>"
              },
              "skills": [
                {
                  "slug": "go",
                  "standing": "primary",
                  "score": 55.0,
                  "rank": 2
                },
                {
                  "slug": "kubernetes",
                  "standing": "primary",
                  "score": 52.0,
                  "rank": 2
                },
                {
                  "slug": "postgres",
                  "standing": "primary",
                  "score": 48.0,
                  "rank": 2
                }
              ],
              "overall_score": 60.4,
              "generalist_score": 122.7,
              "rank": 1
            }
          ]
        }
      }
    },
    {
      "_step": "ORG SCOPING. A colleague sees and can replay what Hank saved.",
      "as": "dave_hiring",
      "request": {
        "method": "GET",
        "path": "/saved-searches"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 2,
          "saved_searches": [
            {
              "id": "<uuid>",
              "name": "Go + Kubernetes",
              "filters": {
                "skills": ["go", "kubernetes"],
                "min_skill_score": 50
              },
              "created_by": {
                "id": "01920000-0000-7000-8000-00000000c001",
                "username": "hank",
                "display_name": "Hank Rivera",
                "active": true
              },
              "created_at": "<timestamp>"
            },
            {
              "id": "<uuid>",
              "name": "Broad generalists",
              "filters": {
                "min_generalist_score": 120
              },
              "created_by": {
                "id": "01920000-0000-7000-8000-00000000c001",
                "username": "hank",
                "display_name": "Hank Rivera",
                "active": true
              },
              "created_at": "<timestamp>"
            }
          ]
        }
      }
    },
    {
      "_step": "...but the GATES still apply per caller. dave_hiring replaying Hank's search cannot see contributor dave through it.",
      "as": "dave_hiring",
      "request": {
        "method": "GET",
        "path": "/saved-searches/{{saved}}/results"
      },
      "expect": {
        "status": 200,
        "_note": "Same stored filters, evaluated as dave_hiring. AssertNotSelf is a property of the caller, never of the saved query.",
        "body": {
          "total": 1,
          "inactive_hidden": 0,
          "ranked_by": "overall",
          "page": 1,
          "per_page": 20,
          "results": [
            {
              "id": "<uuid>",
              "display_name": "Bob Nakamura",
              "github_login": "bobn",
              "active": true,
              "availability": {
                "status": "looking",
                "expires_at": "<timestamp>"
              },
              "skills": [
                {
                  "slug": "go",
                  "standing": "primary",
                  "score": 55.0,
                  "rank": 2
                },
                {
                  "slug": "kubernetes",
                  "standing": "primary",
                  "score": 52.0,
                  "rank": 2
                }
              ],
              "overall_score": 60.4,
              "generalist_score": 122.7,
              "rank": 3
            }
          ]
        }
      }
    },
    {
      "as": "sam_studio",
      "request": {
        "method": "GET",
        "path": "/saved-searches"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 0,
          "saved_searches": []
        }
      }
    },
    {
      "as": "sam_studio",
      "request": {
        "method": "GET",
        "path": "/saved-searches/{{saved}}/results"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "saved_search_not_found"
        }
      }
    },
    {
      "_step": "An unverified hirer cannot save or replay one — the same capability gate as search itself.",
      "as": "pending_pat",
      "request": {
        "method": "POST",
        "path": "/saved-searches",
        "body": {
          "name": "Nope",
          "filters": {
            "skills": ["go"]
          }
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "hiring_capability_required",
          "hirer_verified": false,
          "organization_verified": false
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "DELETE",
        "path": "/saved-searches/{{generalist_saved}}"
      },
      "expect": {
        "status": 204,
        "body": null,
        "db": {
          "saved_searches": {
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b001"
            },
            "count": 1
          }
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/saved-searches/{{generalist_saved}}/results"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "saved_search_not_found"
        }
      }
    }
  ]
}
