                  "score": 79.3
                }
              ]
            }
          ],
          "generalist_score": 64.2
        }
      }
    },
    {
      "_step": "The share link is NOT subject to the availability gate \u2014 it is the contributor's own publication, not a search result.",
      "as": "anonymous",
      "request": {
        "method": "GET",
        "path": "/public/scorecard/not-a-real-token"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "scorecard_not_found"
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "DELETE",
        "path": "/me/share-link/{{share_link_id}}"
      },
      "expect": {
        "status": 204,
        "body": null
      }
    },
    {
      "as": "anonymous",
      "request": {
        "method": "GET",
        "path": "/public/scorecard/{{share_token}}"
      },
      "expect": {
        "status": 404,
        "_note": "Revocation is immediate. A published link the contributor withdrew must stop resolving.",
        "body": {
          "error": "scorecard_not_found"
        }
      }
    }
  ]
}
