      "request": {
        "method": "GET",
        "path": "/leaderboard?kind=overall"
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "overall",
          "rubric_version": "v1",
          "entries": [
            {
              "rank": 1,
              "user_id": "<uuid>",
              "display_name": "Carol Diaz",
              "github_login": "cdiaz",
              "score": 71.5,
              "active": false
            },
            {
              "rank": 2,
              "user_id": "<uuid>",
              "display_name": "Alice Okafor",
              "github_login": "aliceok",
              "score": 64.2,
              "active": true
            },
            {
              "rank": 3,
              "user_id": "<uuid>",
