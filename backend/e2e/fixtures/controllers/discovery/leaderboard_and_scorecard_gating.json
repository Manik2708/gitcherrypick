    {
      "_step": "NO AVAILABILITY GATE \u2014 RFC-0008 \u00a71a. Carol is lapsed and her scorecard is readable, because a hirer who found her through include_inactive must be able to read the evidence.",
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/contributors/01920000-0000-7000-8000-00000000a003/scorecard"
      },
      "expect": {
        "status": 200,
        "_note": "Rank 1 on Postgres while hidden from the default search. The two facts sit side by side and neither is hidden from the hirer.",
        "body": {
          "user": {
            "id": "01920000-0000-7000-8000-00000000a003",
            "display_name": "Carol Diaz",
            "github_login": "cdiaz",
            "active": false,
            "availability": {
              "status": "looking_for_job",
              "last_confirmed_at": "<timestamp>",
              "inactive_for_days": 1
