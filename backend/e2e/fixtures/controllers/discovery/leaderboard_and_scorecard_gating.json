      "_step": "not_looking IS still a 404 \u2014 the only availability state that hides a scorecard. An explicit opt-out is not a stale yes.",
      "as": "carol",
      "request": {
        "method": "PUT",
        "path": "/me/availability",
        "body": {
          "status": "not_looking"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "not_looking",
          "expires_at": "<timestamp>"
        }
