        "method": "PUT",
        "path": "/me/availability",
        "body": {
          "status": "looking_for_job"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "looking_for_job",
          "expires_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "Refreshing changes `active` and the availability block. Every score and rank is untouched.",
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/contributors/01920000-0000-7000-8000-00000000a003/scorecard"
      },
      "expect": {
        "status": 200,
        "body": {
          "user": {
            "id": "01920000-0000-7000-8000-00000000a003",
            "display_name": "Carol Diaz",
            "github_login": "cdiaz",
            "availability": "looking_for_job"
          },
