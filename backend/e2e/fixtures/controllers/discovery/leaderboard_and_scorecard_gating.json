    {
      "_step": "The PUBLIC scorecard is a different document, reached only by a share token the contributor minted \u2014 ADR-0002.",
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/me/share-link",
        "body": {}
      },
      "capture": {
        "share_token": "$.token",
        "share_link_id": "$.id"
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "token": "<token>",
          "url": "<string>",
          "created_at": "<timestamp>"
        }
      }
    },
    {
      "as": "anonymous",
