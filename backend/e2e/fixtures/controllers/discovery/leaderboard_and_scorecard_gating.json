        "method": "GET",
        "path": "/contributors/01920000-0000-7000-8000-00000000a003/scorecard"
      },
      "expect": {
        "status": 404,
        "_note": "Same 404 a nonexistent id returns. A hirer cannot distinguish 'opted out' from 'never existed'.",
        "body": {
          "error": "contributor_not_found"
        }
      }
    },
    {
      "_step": "A contributor cannot read another contributor's scorecard. This is not a social network.",
      "as": "bob",
      "request": {
        "method": "GET",
        "path": "/contributors/01920000-0000-7000-8000-00000000a001/scorecard"
