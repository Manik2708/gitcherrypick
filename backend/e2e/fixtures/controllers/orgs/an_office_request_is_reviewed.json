      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "rejected",
          "reviewed_at": "<timestamp>",
          "reviewed_by": "<uuid>"
        },
        "db": {
          "organization_office_requests": {
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b002"
            },
            "count": 1,
            "all_match": {
              "address_id": null,
              "decision_reason": "The lease is in a director's own name, not the company's."
            },
            "none_match": {
              "decided_at": null,
              "decided_by": null
            }
          },
          "organizations": {
            "where": {
              "id": "01920000-0000-7000-8000-00000000b002"
            },
            "count": 1,
            "all_match": {
              "workplace": "fully_remote"
            }
          },
          "organization_addresses": {
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b002"
            },
            "count": 0
          }
        }
      }
    },
    {
      "_step": "The requesting owner is emailed THE REASON — one message for one decision.",
      "as": "system",
      "request": {
        "method": "READ_EMAIL",
        "path": "/",
        "body": {
          "to": "sam@tinystudio.example",
          "subject": "Your office address was not approved",
          "contains": ["The lease is in a director's own name, not the company's."],
          "count": 1
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "to": "sam@tinystudio.example",
          "subject": "Your office address was not approved",
          "html": "<string>",
          "token": "<string>"
        }
      }
    },
    {
      "_step": "A decided request cannot be decided again — a 409, as for an onboarding submission.",
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/office-requests/{{first_request}}/decide",
