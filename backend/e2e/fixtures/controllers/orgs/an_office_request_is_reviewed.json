    {
      "_step": "The requesting owner is emailed on approval too: one message, naming the city and the country by NAME, from the place service — not the code.",
      "as": "system",
      "request": {
        "method": "READ_EMAIL",
        "path": "/",
        "body": {
          "to": "sam@tinystudio.example",
