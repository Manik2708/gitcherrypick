          "office_request": null
        }
      }
    },
    {
      "_step": "Further addresses are now added by an owner, unreviewed.",
      "as": "sam_studio",
      "request": {
        "method": "POST",
        "path": "/orgs/01920000-0000-7000-8000-00000000b002/addresses",
        "body": {
          "country": "ES",
          "city": "Madrid",
          "postal_code": "28013",
          "street1": "Calle Mayor 10",
          "street2": "3rd floor"
        }
      },
      "expect": {
        "status": 201,
