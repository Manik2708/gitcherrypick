        "db": {
          "organization_addresses": {
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b002"
            },
            "count": 0
          }
        }
      }
    },
    {
      "_step": "Still fully remote, still no address — and the latest request reads REJECTED, with when and why, so the reason is on the screen and not only in an inbox (amendment 1 §1.3).",
      "as": "sam_studio",
      "request": {
        "method": "GET",
        "path": "/orgs/01920000-0000-7000-8000-00000000b002/addresses"
      },
      "expect": {
        "status": 200,
        "body": {
          "workplace": "fully_remote",
          "addresses": [],
          "office_request": {
            "id": "<uuid>",
            "status": "rejected",
            "address": {
              "country": "ES",
              "city": "Madrid",
              "postal_code": "28013",
              "street1": "Calle Mayor 10",
              "street2": "3rd floor"
            },
            "requested_at": "<timestamp>",
            "decided_at": "<timestamp>",
            "reason": "The lease is in a director's own name, not the company's."
          }
        }
      }
    },
    {
      "_step": "AND IT MAY ASK AGAIN AT ONCE: a new row, so the administrator can see what changed. No limit and no wait.",
      "as": "sam_studio",
      "request": {
        "method": "POST",
        "path": "/orgs/01920000-0000-7000-8000-00000000b002/office-request",
        "body": {
          "country": "ES",
          "city": "Barcelona",
          "postal_code": "08002",
          "street1": "Carrer de Ferran 1",
          "street2": "Local 2"
        }
      },
      "capture": {
        "second_request": "$.id"
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "status": "pending",
          "address": {
            "country": "ES",
            "city": "Barcelona",
            "postal_code": "08002",
            "street1": "Carrer de Ferran 1",
            "street2": "Local 2"
          },
          "requested_at": "<timestamp>"
        },
        "db": {
          "organization_office_requests": {
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b002"
            },
            "count": 2
          }
        }
      }
    },
    {
      "_step": "Only the undecided one is queued, and it names the rejected request it SUPERSEDES, so the administrator can read what changed.",
      "as": "root",
      "request": {
        "method": "GET",
        "path": "/admin/office-requests"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 1,
          "office_requests": [
            {
              "id": "<uuid>",
              "organization": {
                "id": "01920000-0000-7000-8000-00000000b002",
                "name": "Tiny Studio"
              },
              "address": {
                "country": "ES",
                "city": "Barcelona",
                "postal_code": "08002",
                "street1": "Carrer de Ferran 1",
                "street2": "Local 2"
              },
              "requested_by": "sam",
              "created_at": "<timestamp>",
              "supersedes": "<uuid>"
            }
          ]
        }
      }
    },
    {
      "_step": "APPROVED. One transaction: the main office, the kind, the stamp.",
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/office-requests/{{second_request}}/decide",
        "body": {
          "decision": "approved"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
