      }
    },
    {
      "_step": "The queue is empty.",
      "as": "root",
      "request": {
        "method": "GET",
        "path": "/admin/office-requests"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 0,
          "office_requests": []
        }
      }
    },
    {
      "_step": "An office organisation, with its main office — and `office_request` is null again: once approved, the address is in `addresses`.",
      "as": "sam_studio",
      "request": {
        "method": "GET",
        "path": "/orgs/01920000-0000-7000-8000-00000000b002/addresses"
