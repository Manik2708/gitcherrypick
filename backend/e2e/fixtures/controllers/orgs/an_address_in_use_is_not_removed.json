          "min_oss_yoe": null,
          "requires_online_test": null,
          "max_interview_rounds": null,
          "avg_days_to_offer": null,
          "questions": [],
          "opened_at": "<timestamp>",
          "close_requested_at": null,
          "closed_at": null,
          "close_reason": null,
          "hires": [],
          "advertised": false,
          "supersedes": null,
          "created_at": "<timestamp>",
          "updated_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "REFUSED: a draft and an open role use it. The refusal names the roles in the way, so the owner knows what to close or revise rather than being told only 'no'.",
      "as": "hank",
      "request": {
        "method": "DELETE",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/addresses/{{acme.address.austin}}"
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "address_in_use",
          "roles": [
            {
              "id": "<uuid>",
              "title": "Austin field engineer",
              "status": "draft"
            },
            {
              "id": "<uuid>",
              "title": "Austin support lead",
              "status": "open"
            }
          ]
        },
        "db": {
          "organization_addresses": {
            "where": {
              "id": "{{acme.address.austin}}"
            },
            "count": 1,
            "all_match": {
              "removed_at": null
            }
          }
        }
      }
    },
    {
      "_step": "The draft is edited to drop its onsite entry — a draft's entries are written on PATCH (decision 4).",
      "as": "hank",
      "request": {
        "method": "PATCH",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{draft}}",
        "body": {
          "title": "Austin field engineer",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote",
              "country": "US"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "organization_id": "01920000-0000-7000-8000-00000000b001",
          "status": "draft",
          "title": "Austin field engineer",
          "description": "",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote",
              "country": "US",
              "address": null
            }
          ],
          "currency": "",
          "yearly_ctc": null,
          "yearly_base": null,
          "hourly_rate": null,
          "expected_hours": null,
          "min_office_yoe": null,
          "min_oss_yoe": null,
          "requires_online_test": null,
          "max_interview_rounds": null,
          "avg_days_to_offer": null,
          "questions": [],
          "opened_at": null,
          "close_requested_at": null,
          "closed_at": null,
          "close_reason": null,
          "hires": [],
          "advertised": false,
          "supersedes": null,
          "created_at": "<timestamp>",
          "updated_at": "<timestamp>"
        },
        "db": {
          "role_locations": {
            "where": {
              "role_id": "{{draft}}"
            },
            "count": 1,
            "all_match": {
              "mode": "remote",
              "country": "US",
              "address_id": null
            }
          }
        }
      }
    },
    {
      "_step": "Still refused: the OPEN role uses it, and an open role cannot be edited — it can only be closed or revised.",
      "as": "hank",
      "request": {
        "method": "DELETE",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/addresses/{{acme.address.austin}}"
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "address_in_use",
          "roles": [
            {
              "id": "<uuid>",
              "title": "Austin support lead",
              "status": "open"
            }
          ]
        }
      }
    },
    {
      "_step": "The open role is closed.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{open_role}}/close",
        "body": {
          "reason": "hired_elsewhere"
