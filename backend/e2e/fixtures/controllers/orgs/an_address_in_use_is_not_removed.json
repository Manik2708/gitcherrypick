      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "organization_id": "01920000-0000-7000-8000-00000000b001",
          "status": "open",
          "title": "Austin support lead",
          "description": "",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote",
              "country": "US",
              "address": null
            },
            {
              "mode": "onsite",
              "country": null,
              "address": {
                "id": "01920000-0000-7000-8000-0000000ad002",
                "country": "US",
                "city": "Austin",
                "postal_code": "78701",
                "street1": "500 W 2nd St",
                "street2": "Suite 300",
                "is_main_office": false,
                "removed": false
              }
            }
