              "is_main_office": true,
              "removed": false
            }
          ],
          "office_request": null
        }
      }
    },
    {
      "_step": "A removed address cannot be written onto a NEW role. The entry is named: field locations, position 2.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles",
        "body": {
          "title": "Back in Austin",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote",
              "country": "US"
            },
            {
              "mode": "onsite",
              "address_id": "{{acme.address.austin}}"
            }
          ]
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "address_removed",
          "field": "locations",
          "position": 2
        }
      }
    },
    {
      "_step": "...nor onto a draft by PATCH.",
      "as": "hank",
      "request": {
        "method": "PATCH",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{draft}}",
        "body": {
          "title": "Austin field engineer",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "onsite",
              "address_id": "{{acme.address.austin}}"
            }
          ]
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "address_removed",
          "field": "locations",
          "position": 1
        },
        "db": {
          "role_locations": {
            "where": {
              "role_id": "{{draft}}"
            },
            "count": 1,
            "all_match": {
              "mode": "remote",
              "country": "US"
            }
          }
        }
      }
    },
    {
      "_step": "...nor by revising an open role. A refused revise writes no successor and closes nothing.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{acme.role}}/revise",
        "body": {
          "title": "Backend engineer",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "onsite",
              "address_id": "{{acme.address.austin}}"
            }
          ]
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": "address_removed",
          "field": "locations",
          "position": 1
        },
        "db": {
          "roles": {
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b001"
            },
            "count": 3
          }
        }
      }
    }
  ]
}
