          "min_office_yoe": null,
          "min_oss_yoe": null,
          "requires_online_test": null,
          "max_interview_rounds": null,
          "avg_days_to_offer": null,
          "questions": [],
          "opened_at": "<timestamp>",
          "close_requested_at": null,
