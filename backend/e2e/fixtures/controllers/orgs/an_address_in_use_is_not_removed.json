      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "organization_id": "01920000-0000-7000-8000-00000000b001",
          "status": "closed",
          "title": "Austin support lead",
          "description": "",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote",
              "country": "US",
              "address": null
            },
            {
              "mode": "onsite",
              "country": null,
              "address": {
                "id": "01920000-0000-7000-8000-0000000ad002",
                "country": "US",
                "city": "Austin",
                "postal_code": "78701",
                "street1": "500 W 2nd St",
                "street2": "Suite 300",
                "is_main_office": false,
                "removed": false
              }
            }
          ],
          "currency": "",
          "yearly_ctc": null,
          "yearly_base": null,
          "hourly_rate": null,
          "expected_hours": null,
          "min_office_yoe": null,
          "min_oss_yoe": null,
          "requires_online_test": null,
          "max_interview_rounds": null,
          "avg_days_to_offer": null,
          "questions": [],
          "opened_at": "<timestamp>",
          "close_requested_at": null,
          "closed_at": "<timestamp>",
          "close_reason": "hired_elsewhere",
          "hires": [],
          "advertised": false,
          "supersedes": null,
          "created_at": "<timestamp>",
          "updated_at": "<timestamp>"
        }
      }
    },
    {
      "_step": "NOW IT IS REMOVED: only a closed role uses it.",
      "as": "hank",
      "request": {
        "method": "DELETE",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/addresses/{{acme.address.austin}}"
      },
      "expect": {
        "status": 204,
        "body": null,
        "db": {
          "organization_addresses": {
            "where": {
              "id": "{{acme.address.austin}}"
            },
            "count": 1,
            "all_match": {
              "removed_by": "01920000-0000-7000-8000-00000000c001"
            },
            "none_match": {
              "removed_at": null
            }
          }
        }
      }
    },
    {
      "_step": "THE CLOSED ROLE STILL SAYS WHERE IT WAS. The address is embedded in full, now marked removed — which is the whole reason removal is a stamp and not a delete.",
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/org-roles/01920000-0000-7000-8000-00000000b001/roles/{{open_role}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "organization_id": "01920000-0000-7000-8000-00000000b001",
          "status": "closed",
          "title": "Austin support lead",
          "description": "",
          "engagement": "full_time",
          "locations": [
            {
              "mode": "remote",
              "country": "US",
              "address": null
            },
            {
              "mode": "onsite",
              "country": null,
              "address": {
                "id": "01920000-0000-7000-8000-0000000ad002",
                "country": "US",
                "city": "Austin",
                "postal_code": "78701",
                "street1": "500 W 2nd St",
