          "hirer_accounts": {
            "_note": "The SEAT STAYS, stamped. It authored rounds and the permanent record of which candidates were told an organisation was interested; deleting it would orphan the history a contributor relies on to know who approached them (§8).",
            "where": {
              "username": "rita"
            },
            "count": 1,
            "none_match": {
              "disabled_at": null
            },
            "all_match": {
              "disabled_by": "01920000-0000-7000-8000-00000000c001"
            }
          },
          "organization_members": {
            "_note": "The membership stays too. A revoked seat keeps its place in the organisation it worked for.",
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b001"
            },
            "count": 4
          },
          "sessions": {
            "_note": "Every family, not just the current one: access ends on every device.",
            "where": {
              "revoked_at": null
            },
            "none_match": {
              "hirer_account_id": "{{rita_id}}"
            }
          }
        }
      }
    },
    {
      "_step": "Rita's access token was minted before the removal and is refused now.",
      "as": "anonymous",
      "request": {
        "method": "GET",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/seats",
        "headers": {
          "Authorization": "Bearer {{rita_token}}"
        }
      },
      "expect": {
        "status": 401,
        "_note": "Not in fifteen minutes' time, when the access token would have expired anyway — now, because the session family is checked on every request.",
        "body": {
          "error": "unauthenticated"
        }
      }
    },
    {
      "_step": "THE REVOKED SEAT IS SILENT. Same username, same password, and now indistinguishable from a name nobody ever held.",
      "as": "anonymous",
      "request": {
        "method": "POST",
        "path": "/auth/hirer/login",
        "body": {
          "username": "rita",
          "password": "correct-horse-battery"
        }
      },
      "expect": {
        "status": 401,
        "_note": "NOT 403 'account_disabled'. ByUsername filters disabled_at out (ADR-0016 §5) precisely so sign-in cannot report that a revoked seat exists — which would tell a departed employee, or anyone holding their password, that the name is real and the account is merely switched off.",
        "body": {
          "error": "invalid_credentials"
        }
      }
    },
    {
      "as": "anonymous",
      "request": {
        "method": "POST",
        "path": "/auth/hirer/login",
        "body": {
          "username": "nobody-ever",
          "password": "correct-horse-battery"
        }
      },
      "expect": {
        "status": 401,
        "_note": "The comparison that makes the previous step mean something: byte-identical.",
        "body": {
          "error": "invalid_credentials"
        }
      }
    },
    {
      "_step": "The revoked seat is still LISTED, marked active:false. That is the whole point of not deleting it — the author of an old round has to stay resolvable (§9).",
      "as": "hank",
      "request": {
        "method": "GET",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/seats"
      },
      "expect": {
        "status": 200,
        "_note": "Live seats first, then revoked. Mo redeemed after Rita, so the live group ends with Mo.",
        "body": {
          "seats": [
            {
              "id": "01920000-0000-7000-8000-00000000c001",
              "username": "hank",
              "display_name": "Hank Rivera",
              "email": "hank@acme.com",
              "role": "owner",
              "active": true,
              "disabled_at": null
            },
            {
              "id": "01920000-0000-7000-8000-00000000c004",
              "username": "dave_h",
              "display_name": "Dave Whitfield",
              "email": "dave.hiring@example.com",
              "role": "member",
              "active": true,
              "disabled_at": null
            },
            {
              "id": "<uuid>",
              "username": "mo",
              "display_name": "Mo Adeyemi",
              "email": "mo@acme.com",
              "role": "owner",
              "active": true,
              "disabled_at": null
            },
            {
              "id": "<uuid>",
              "username": "rita",
              "display_name": "Rita Sandoval",
              "email": "rita@acme.com",
              "role": "member",
              "active": false,
              "disabled_at": "<timestamp>"
            }
          ]
        }
      }
    },
    {
      "_step": "The name is NEVER reissued. A revoked seat keeps it forever, which is what makes an old round's author unambiguous (§Identity).",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/roster",
        "body": {
          "email": "rita.two@acme.com",
          "username": "rita",
          "role": "member"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "username_taken"
        },
        "db": {
          "organization_hirer_roster": {
            "where": {
              "email": "rita.two@acme.com"
            },
            "count": 0
          }
        }
      }
    },
    {
      "_step": "An owner may revoke another OWNER. Mo holds an owner seat and Hank removes it.",
      "as": "hank",
      "request": {
        "method": "DELETE",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/roster/{{mo_entry}}"
      },
      "expect": {
        "status": 204,
        "body": null,
        "db": {
          "hirer_accounts": {
            "where": {
              "username": "mo"
            },
            "count": 1,
            "none_match": {
              "disabled_at": null
            },
            "all_match": {
              "disabled_by": "01920000-0000-7000-8000-00000000c001"
            }
          }
        }
      }
    },
    {
      "_step": "Expiry. A third address, a proof, and then more than the 24-hour window (ADR-0016 §7).",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/roster",
        "body": {
          "email": "slow@acme.com",
          "username": "slow",
          "role": "member"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "email": "slow@acme.com",
          "username": "slow",
          "role": "member",
          "added_by": {
            "id": "01920000-0000-7000-8000-00000000c001",
            "username": "hank",
            "display_name": "Hank Rivera",
            "active": true
          },
          "redeemed_at": null,
          "redeemed_by": null,
          "created_at": "<timestamp>"
        }
      }
    },
    {
      "as": "anonymous",
      "request": {
        "method": "POST",
        "path": "/auth/hirer/redeem/start",
        "body": {
          "org_slug": "acme",
          "email": "slow@acme.com"
        }
      },
      "expect": {
        "status": 202,
        "body": null
      }
    },
    {
      "as": "system",
      "request": {
        "method": "READ_EMAIL",
        "path": "/",
        "body": {
          "to": "slow@acme.com",
          "subject": "Confirm your email address",
          "count": 1
        }
      },
      "capture": {
        "slow_proof": "$.token"
      },
      "expect": {
        "status": 200,
        "body": {
          "to": "slow@acme.com",
          "subject": "Confirm your email address",
          "html": "<string>",
          "token": "<token>"
        }
      }
    },
    {
      "as": "system",
      "request": {
        "method": "ADVANCE_CLOCK",
        "path": "/"
      },
      "fake": {
        "clock": {
          "advance": "25h"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "now": "<timestamp>"
        }
      }
    },
    {
      "_step": "410, and told apart from spent: the remedy is a fresh link, not signing in.",
      "as": "anonymous",
      "request": {
        "method": "POST",
        "path": "/auth/hirer/redeem/complete",
        "body": {
          "token": "{{slow_proof}}",
          "display_name": "Slow Coach",
          "password": "correct-horse-battery"
        }
      },
      "expect": {
        "status": 410,
        "body": {
          "error": "verification_expired"
        },
        "db": {
          "hirer_accounts": {
            "where": {
              "username": "slow"
            },
            "count": 0
          }
        }
      }
    }
  ]
}
