            "_note": "The role came from the entry, and the entry said owner.",
            "where": {
              "organization_id": "01920000-0000-7000-8000-00000000b001",
              "role": "owner"
            },
            "count": 2
          }
        }
      }
    },
    {
      "_step": "The seat signs in like any other, on the password its holder chose and the username its organisation pinned.",
      "as": "anonymous",
      "request": {
        "method": "POST",
        "path": "/auth/hirer/login",
        "body": {
          "username": "rita",
          "password": "correct-horse-battery"
        }
      },
      "expect": {
        "status": 200,
        "_note": "A SECOND session family for Rita. The removal below has to kill both, which is what 'every family, not just one' means.",
        "body": {
          "hirer": {
            "id": "<uuid>",
            "display_name": "Rita Sandoval",
            "email": "rita@acme.com",
            "principal_type": "hirer",
            "verified": true,
            "organization": {
              "id": "01920000-0000-7000-8000-00000000b001",
              "name": "Acme Corp",
              "verified": true,
              "payment_verified": true
            }
          },
          "access_token": "<token>",
          "refresh_token": "<token>",
          "expires_in": 900
        }
      }
    },
    {
      "_step": "Removal. Rita leaves Acme.",
      "as": "hank",
      "request": {
        "method": "DELETE",
        "path": "/orgs/01920000-0000-7000-8000-00000000b001/roster/{{rita_entry}}"
      },
      "expect": {
        "status": 204,
        "body": null,
        "db": {
          "organization_hirer_roster": {
            "_note": "The ENTRY goes, so the address cannot be redeemed again.",
            "where": {
              "email": "rita@acme.com"
            },
            "count": 0
