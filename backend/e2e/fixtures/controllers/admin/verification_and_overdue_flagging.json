            }
          ]
        }
      }
    },
    {
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/shortlists/{{shortlist_b_id}}/entries",
        "body": {
          "user_id": "01920000-0000-7000-8000-00000000a002"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "shortlist_id": "<uuid>",
          "user": {
            "id": "01920000-0000-7000-8000-00000000a002",
            "display_name": "Bob Nakamura",
            "github_login": "<string>"
          },
          "note": null,
          "added_by": {
            "id": "01920000-0000-7000-8000-00000000c001",
