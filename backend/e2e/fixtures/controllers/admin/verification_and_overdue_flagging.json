    {
      "_step": "Two of three overdue is 67% — below the threshold, so nothing fires.",
      "as": "system",
      "request": {
        "method": "RUN_OVERDUE_SWEEP",
        "path": "/"
      },
      "expect": {
        "status": 200,
        "body": {
          "organizations_checked": 3,
          "flagged": 0
        }
      }
    },
    {
      "_step": "Closing the in-date round leaves 2 of 2 overdue — 100%, over the threshold.",
      "as": "hank",
      "request": {
        "method": "POST",
        "path": "/shortlists/{{shortlist_c_id}}/close",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "closed",
          "closed_at": "<timestamp>",
