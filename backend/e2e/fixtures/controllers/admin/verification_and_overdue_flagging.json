    {
      "as": "system",
      "request": {
        "method": "RUN_OVERDUE_SWEEP",
        "path": "/"
      },
      "expect": {
        "status": 200,
        "body": {
          "organizations_checked": 3,
          "flagged": 1,
          "flagged_organizations": [
            {
              "id": "<uuid>",
              "name": "Acme Corp",
              "open_shortlists": 2,
