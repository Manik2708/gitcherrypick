    {
      "as": "system",
      "request": {
        "method": "ADVANCE_CLOCK",
        "path": "/"
      },
      "fake": {
        "clock": {
          "set": "2026-09-01T00:00:00Z"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "now": "<timestamp>"
        }
