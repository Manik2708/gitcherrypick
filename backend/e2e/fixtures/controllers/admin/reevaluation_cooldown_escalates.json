{
  "name": "re-evaluation requests, escalating cooldown, and the labelled set",
  "description": "ADR-0007 §6. Three rejections trigger a 28-day cooldown; the counter resets when it expires and the NEXT cooldown doubles — 28, 56, 112, 224, capped at 365. Doubling costs an honest contributor who misjudged once almost nothing while making systematic disputing progressively pointless. The cap is deliberate: past about a year a cooldown is a ban, and a ban should be an admin decision with a reason rather than a counter reaching a large number.\n\nCritically, ACCEPTED requests neither reset nor increment the counter. A contributor who is repeatedly right is never throttled — and they are exactly the population whose disputes are worth most, because each accepted one is a human-ranked disagreement on real evidence: the labelled set calibration said could not exist before launch.",
  "seed": ["principals", "catalogue", "repositories", "alice_go_primary"],
  "steps": [
    {
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "PR 3 was scored 12 on craft but it added the first test suite this package ever had."
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "status": "pending",
          "created_at": "<timestamp>"
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "Still think craft is wrong."
        }
      },
      "expect": {
        "status": 409,
        "_note": "One outstanding request per claim — the partial unique index enforces it.",
        "body": {
          "error": "request_already_open"
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "root",
      "request": {
        "method": "GET",
        "path": "/admin/reevaluations?status=pending"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 1,
          "requests": [
            {
              "id": "<uuid>",
              "user": {
                "display_name": "Alice Okafor"
              },
              "claim_id": "<uuid>",
              "reason": "<string>",
              "created_at": "<timestamp>"
            }
          ]
        }
      }
    },
    {
      "_step": "ACCEPTED. The claim is re-queued and the disagreement is recorded for tuning.",
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/reevaluations/{{reevaluation_id}}/decide",
        "body": {
          "decision": "accepted",
          "note": "Agreed — craft undervalued the introduction of a test suite."
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "accepted",
          "reviewed_at": "<timestamp>",
          "claim_requeued": true
        },
        "db": {
          "reevaluation_cooldowns": {
            "_note": "Untouched by an acceptance. Being right costs nothing.",
            "where": {
              "user_id": "{{alice.id}}"
            },
            "count": 1,
            "all_match": {
              "rejection_count": 0,
              "tier": 0,
              "cooldown_until": null
            }
          },
          "evaluation_jobs": {
            "where": {
              "topic": "claims.live"
            },
            "count": 1
          }
        }
      }
    },
    {
      "_step": "Three rejected requests. The counter only moves on rejection.",
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "Complexity should be higher."
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "status": "pending",
          "created_at": "<timestamp>"
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/reevaluations/{{reevaluation_id}}/decide",
        "body": {
          "decision": "rejected",
          "note": "Complexity is assessed on the problem, not the diff size."
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "rejected",
          "reviewed_at": "<timestamp>",
          "claim_requeued": false
        },
        "db": {
          "reevaluation_cooldowns": {
            "where": {
              "user_id": "{{alice.id}}"
            },
            "all_match": {
              "rejection_count": 1,
              "tier": 0,
              "cooldown_until": null
            }
          }
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "Substance too low."
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "status": "pending",
          "created_at": "<timestamp>"
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/reevaluations/{{reevaluation_id}}/decide",
        "body": {
          "decision": "rejected",
          "note": "Assessment stands."
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "rejected",
          "reviewed_at": "<timestamp>",
          "claim_requeued": false
        },
        "db": {
          "reevaluation_cooldowns": {
            "where": {
              "user_id": "{{alice.id}}"
            },
            "all_match": {
              "rejection_count": 2,
              "tier": 0,
              "cooldown_until": null
            }
          }
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "Reconsider the whole claim."
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "status": "pending",
          "created_at": "<timestamp>"
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/reevaluations/{{reevaluation_id}}/decide",
        "body": {
          "decision": "rejected",
          "note": "Assessment stands."
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "rejected",
          "reviewed_at": "<timestamp>",
          "claim_requeued": false
        },
        "db": {
          "reevaluation_cooldowns": {
            "_note": "Third rejection: tier 1, 28 days, and the counter resets to 0.",
            "where": {
              "user_id": "{{alice.id}}"
            },
            "all_match": {
              "rejection_count": 0,
              "tier": 1
            },
            "none_match": {
              "cooldown_until": null
            }
          }
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "One more."
        }
      },
      "expect": {
        "status": 429,
        "_note": "The expiry date is in the error, so the contributor knows when they may try again.",
        "body": {
          "error": "reevaluation_cooldown",
          "cooldown_until": "<timestamp>",
          "message": "You have three rejected re-evaluation requests. You can request again after the cooldown ends."
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "system",
      "request": {
        "method": "ADVANCE_CLOCK",
        "path": "/"
      },
      "fake": {
        "clock": {
          "advance": "28d1h"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "now": "<timestamp>"
        }
      }
    },
    {
      "_step": "Cooldown expired — three fresh attempts, but tier stays at 1 so the next one is 56 days.",
      "as": "alice",
      "request": {
        "method": "POST",
        "path": "/claims/{{alice_go_claim.id}}/reevaluation",
        "body": {
          "reason": "Fresh attempt after the cooldown."
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<uuid>",
          "status": "pending",
          "created_at": "<timestamp>"
        }
      },
      "capture": {
        "reevaluation_id": "$.id"
      }
    },
    {
      "as": "root",
      "request": {
        "method": "POST",
        "path": "/admin/reevaluations/{{reevaluation_id}}/decide",
        "body": {
          "decision": "rejected",
          "note": "Assessment stands."
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<uuid>",
          "status": "rejected",
          "reviewed_at": "<timestamp>",
          "claim_requeued": false
        },
        "db": {
          "reevaluation_cooldowns": {
            "where": {
              "user_id": "{{alice.id}}"
            },
            "all_match": {
              "rejection_count": 1,
              "tier": 1
            }
          }
        }
      }
    },
    {
      "_step": "Two more rejections reach the second cooldown, which must be 56 days rather than another 28.",
      "as": "system",
      "request": {
        "method": "REJECT_N_REEVALUATIONS",
        "path": "/",
        "body": {
          "user": "alice",
          "count": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "rejected": 2
        },
        "db": {
          "reevaluation_cooldowns": {
            "where": {
              "user_id": "{{alice.id}}"
            },
            "all_match": {
              "rejection_count": 0,
              "tier": 2
            }
          }
        }
      }
    },
    {
      "as": "alice",
      "request": {
        "method": "GET",
        "path": "/me/reevaluation-status"
      },
      "expect": {
        "status": 200,
        "body": {
          "_note": "Second tier. The count resets when a cooldown is served, so rejection_count reads 0 while tier still records how far the escalation went — 56 days rather than another 28 (ADR-0007 §6).",
          "rejection_count": 0,
          "tier": 2,
          "cooldown_until": "<timestamp>",
          "cooldown_days": 56,
          "can_request": false,
          "blocked_by": "cooldown",
          "claims_eligible": []
        }
      }
    },
    {
      "_step": "The accepted request from the start is the labelled-set record — retrievable for tuning.",
      "as": "root",
      "request": {
        "method": "GET",
        "path": "/admin/reevaluations?status=accepted"
      },
      "expect": {
        "status": 200,
        "body": {
          "total": 1,
          "requests": [
            {
              "id": "<uuid>",
              "user": {
                "display_name": "Alice Okafor"
              },
              "claim_id": "<uuid>",
              "reason": "<string>",
              "decision_note": "<string>",
              "created_at": "<timestamp>",
              "reviewed_at": "<timestamp>",
              "_note": "A human-ranked disagreement on real evidence. calibration.md said this data could not exist before launch; the dispute flow manufactures it as a side effect of a feature contributors want anyway."
            }
          ]
        }
      }
    }
  ]
}
